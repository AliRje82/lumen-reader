# Google OAuth Client ID (Web application type)
# Create at https://console.cloud.google.com/apis/credentials
# Enable: Google Drive API, Google Picker API
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: Google API Key for Picker (Browser key, restrict by HTTP referrer)
VITE_GOOGLE_API_KEY=your-api-key

# Optional: App ID from Google Cloud project (numeric project number)
VITE_GOOGLE_APP_ID=
